# Copy to .env (never commit .env).

# Optional: enables AI narrative summaries, photo transcription and "Ask about this report".
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Signs login tokens. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# SQLite file for accounts and saved reports (default: backend/data/medeasy.db)
# DATABASE_PATH=

# Comma-separated allowed origins if the frontend is hosted elsewhere (default *)
# CORS_ORIGINS=

# Frontend only: set when the API is on a different origin from the frontend
# VITE_BACKEND_URL=
